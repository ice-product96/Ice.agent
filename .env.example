# --- Panel (bootstrap only) ---
# All Telegram / LLM / Mem0 / search / MCP settings are configured in the web UI.
ICE_SECRET_KEY=change-me-to-a-long-random-string
ICE_ADMIN_PASSWORD=change-me

# --- Database ---
# Local/dev SQLite. Docker Compose overrides this to Postgres automatically.
ICE_DATABASE_URL=sqlite+aiosqlite:///./data/ice_agent.db

# --- Optional paths (Compose sets these) ---
# ICE_SESSION_DIR=/app/data/sessions
# ICE_BACKUP_DIR=/app/data/backups
