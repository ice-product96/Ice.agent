# --- Panel ---
# Technical bootstrap only. All Telegram, LLM, memory, search, MCP and agent
# settings are configured in the web dashboard and encrypted in the database.
ICE_SECRET_KEY=change-me-to-a-long-random-string
ICE_ADMIN_PASSWORD=change-me

# --- Database ---
# dev (default): sqlite. prod: postgresql+asyncpg://ice:ice@postgres:5432/ice_agent
ICE_DATABASE_URL=sqlite+aiosqlite:///./data/ice_agent.db
