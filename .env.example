# --- Panel (bootstrap only) ---
# All Telegram / LLM / Mem0 / search / MCP settings are configured in the web UI.
ICE_SECRET_KEY=change-me-to-a-long-random-string
ICE_ADMIN_PASSWORD=change-me

# --- Database ---
# Local/dev SQLite. Docker Compose overrides this to Postgres automatically.
ICE_DATABASE_URL=sqlite+aiosqlite:///./data/ice_agent.db

# --- Optional paths (Compose sets these) ---
# ICE_SESSION_DIR=/app/data/sessions
# ICE_BACKUP_DIR=/app/data/backups

# --- Docker UI build (npm). Use if registry.npmjs.org times out ---
# HTTP_PROXY=http://user:pass@host:8080
# HTTPS_PROXY=http://user:pass@host:8080
# NO_PROXY=localhost,127.0.0.1
# NPM_REGISTRY=https://registry.npmmirror.com

# --- Playwright MCP (local browser for agents) ---
# Compose service: iceagent-playwright on 127.0.0.1:8931
# In UI → MCP add server:
#   name: playwright
#   transport: streamable-http
#   url: http://playwright:8931/mcp

# --- SIP UA (OpenAI Realtime voice calls) ---
# Public/LAN IP put into SDP when the API container is behind NAT (Telphin etc.)
# ICE_SIP_PUBLIC_IP=192.168.10.64
# ICE_SIP_BIND_PORT=5060
# ICE_SIP_RTP_PORT_MIN=10000
# ICE_SIP_RTP_PORT_MAX=10199
# ICE_SIP_STUN_SERVER=